{
  "name": "@inf-ui/components",
  "type": "module",
  "version": "0.0.2",
  "description": "Infui ui components package for Vue 3",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vue-tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "inf-css": "^0.0.1",
    "tsup": "^8.5.1",
    "unplugin-vue": "^7.2.0"
  },
  "peerDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.35"
  },
  "dependencies": {
    "vue-tsc": "^3.3.3"
  }
}
