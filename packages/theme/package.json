{
  "name": "@infui/theme",
  "version": "0.0.1",
  "type": "module",
  "description": "Infui theme package",
  "main": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./index.scss": "./src/index.scss",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "sass src/index.scss dist/index.css --style compressed --no-source-map",
    "dev": "sass src/index.scss dist/index.css --watch"
  },
  "devDependencies": {
    "sass": "^1.100.0"
  }
}
