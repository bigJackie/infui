{
  "name": "inf-ui",
  "type": "module",
  "version": "0.0.1",
  "description": "Infui is a UI framework for Vue 3",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@infui/components": "workspace:*",
    "@infui/theme": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "unplugin-vue": "^7.2.0",
    "tsup": "^8.5.1"
  }
}
